{
    "swagger": "2.0",
    "info": {
        "description": "This is a real-time social discovery engine.",
        "title": "Radar Momentum API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/plans/{id}/checkin": {
            "post": {
                "description": "Increments the check-in count for a specific plan",
                "tags": [
                    "plans"
                ],
                "summary": "Check in to a plan",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Plan ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/plans/{id}/save": {
            "post": {
                "description": "Increments the save count for a specific plan",
                "tags": [
                    "plans"
                ],
                "summary": "Save a plan",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Plan ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/radar": {
            "get": {
                "description": "Fetches plans within a radius and sorts by momentum score",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "plans"
                ],
                "summary": "Get nearby trending plans",
                "parameters": [
                    {
                        "type": "number",
                        "format": "float64",
                        "description": "Latitude",
                        "name": "lat",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "number",
                        "format": "float64",
                        "description": "Longitude",
                        "name": "lng",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Plan"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "models.Plan": {
            "type": "object",
            "properties": {
                "base_score": {
                    "description": "Analytics signals for the Momentum Engine",
                    "type": "number"
                },
                "check_ins": {
                    "description": "Real-time presence",
                    "type": "integer"
                },
                "created_at": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "lat": {
                    "type": "number"
                },
                "lng": {
                    "type": "number"
                },
                "momentum_score": {
                    "description": "Enriched Fields",
                    "type": "number"
                },
                "saves": {
                    "description": "Intent signal",
                    "type": "integer"
                },
                "status": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        }
    }
}